# --- LLM (generation) ---
# Providers: ollama | gemini | groq | openai_compat | fake
LLM_PROVIDER=ollama
# Ollama cloud model (fast JSON: deepseek-v4.1-flash, gpt-oss:20b, mimo-v2.6-flash).
# For Gemini use gemini-3.5-flash (2.5-* models are retired for new keys).
LLM_MODEL=deepseek-v4.1-flash
# Optional provider-level fallback when the primary fails (e.g. gemini).
LLM_FALLBACK_PROVIDER=gemini
# Model used when Gemini itself fails or when LLM_PROVIDER=gemini.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Ollama (cloud https://ollama.com/v1, or local http://host.docker.internal:11434/v1) ---
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

GEMINI_API_KEY=
GROQ_API_KEY=
# Required for openai_compat (vLLM/Azure-compatible endpoint).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=300
# Retry/backoff for OpenAI-compatible providers (Ollama, Groq, vLLM, Azure).
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0
LLM_RETRY_MAX_SECONDS=8.0

# --- Background jobs (Celery) ---
# Set USE_CELERY=false to run generation in the API process (tests/local debugging).
USE_CELERY=true
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_SECONDS=5.0
CELERY_RETRY_MAX_BACKOFF_SECONDS=300.0
CELERY_QUEUE=generation

# --- Embeddings ---
# Ollama cloud has no embeddings endpoint: keep gemini (or run a local model).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# --- Gemini free-tier safety ---
GEMINI_MIN_INTERVAL_SECONDS=4.0
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_BASE_SECONDS=2.0
GEMINI_RETRY_MAX_SECONDS=32.0

# --- Storage ---
DATABASE_URL=postgresql+psycopg://spec2backlog:spec2backlog@db:5432/spec2backlog
CHROMA_HOST=chroma
CHROMA_PORT=8000
UPLOADS_DIR=data/uploads

# --- Retrieval ---
SIMILAR_TOP_K=3
SIMILAR_MIN_SCORE=0.55
LEXICAL_MIN_SCORE=0.12
GRAPH_MAX_LINKS_PER_NODE=8
GRAPH_MIN_LINK_SCORE=0.45

# --- Pipeline knobs ---
MAX_LEAF_TOKENS=1500
CONTEXT_MAX_TOKENS=6000
DEMO_DELAY_MS=0
