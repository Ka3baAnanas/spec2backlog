# --- LLM (generation) ---
LLM_PROVIDER=groq              # groq | azure_openai | local (OpenAI-compatible, e.g. vLLM/Ollama)
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
LLM_BASE_URL=                  # for azure_openai/local

# --- Embeddings ---
EMBEDDING_PROVIDER=gemini      # gemini | openai_compatible | local_bge
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=                # use a PAID-tier key for real client data

# --- Storage ---
DATABASE_URL=postgresql+psycopg://spec2backlog:spec2backlog@db:5432/spec2backlog
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- Pipeline knobs ---
SIMILAR_TOP_K=3
SIMILAR_MIN_SCORE=0.55
MAX_LEAF_TOKENS=1500
DEMO_DELAY_MS=0               # artificial per-leaf delay (ms) to make demo animations visible
