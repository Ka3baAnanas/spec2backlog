# --- LLM (generation) ---
LLM_PROVIDER=gemini                 # gemini | groq | openai_compat | fake
LLM_MODEL=gemini-3.5-flash-lite     # stable free-tier text model (3.8/3.6 flash also free)
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=                       # required for openai_compat (vLLM/Ollama/Azure-compatible)

# --- Embeddings ---
EMBEDDING_PROVIDER=gemini           # gemini | fake
EMBEDDING_MODEL=gemini-embedding-2  # current free-tier model (text-only: gemini-embedding-001)

# --- Gemini free-tier safety ---
GEMINI_MIN_INTERVAL_SECONDS=4.0     # ~15 requests/minute
GEMINI_MAX_RETRIES=6
GEMINI_RETRY_BASE_SECONDS=2.0
GEMINI_RETRY_MAX_SECONDS=60.0

# --- Storage ---
DATABASE_URL=postgresql+psycopg://spec2backlog:spec2backlog@db:5432/spec2backlog
CHROMA_HOST=chroma
CHROMA_PORT=8000
UPLOADS_DIR=data/uploads

# --- Retrieval ---
SIMILAR_TOP_K=3
SIMILAR_MIN_SCORE=0.55
LEXICAL_MIN_SCORE=0.12

# --- Pipeline knobs ---
MAX_LEAF_TOKENS=1500
CONTEXT_MAX_TOKENS=6000
DEMO_DELAY_MS=0               # artificial per-leaf delay (ms) to make demo animations visible
